<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CrearRutinaActivity"
    android:orientation="vertical"
    android:background="@color/fondoPantallas"
    android:weightSum="1">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="30dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/buscador">
            <ImageView
                android:id="@+id/vector_lupa"
                android:layout_width="95dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:src="@drawable/lupa"
                android:elevation="1dp"
                app:layout_constraintStart_toStartOf="parent"
                app:tint="@color/textos">
            </ImageView>
            <EditText
                android:id="@+id/buscador"
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:background="@color/buscador"
                android:hint="@string/buscar_ejercicio"
                android:textColorHint="@color/textos"
                android:textColor="@color/textos"
                android:textSize="25sp"
                android:maxLines="1"
                android:inputType="text"
                android:imeOptions="actionSearch">
            </EditText>
            <ImageView
                android:id="@+id/quitarTextoBuscador"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:src="@drawable/x"
                app:tint="@color/textos">
            </ImageView>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:id="@+id/chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingEnd="1dp"
            android:text="@string/Filtrar"
            android:textColor="@color/textos"
            android:textSize="20sp">
        </TextView>
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacing="4dp"
            app:singleLine="false">
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:weightSum="3"
        android:orientation="horizontal">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="30dp"
                android:layout_margin="4dp">
                <TextView
                    android:id="@+id/botonFavoritos"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/cuadros"
                    android:text="@string/favoritos"
                    android:textColor="@color/textos"
                    android:textSize="17sp"
                    android:gravity="center|bottom"
                    android:paddingBottom="10dp">
                </TextView>
            </androidx.cardview.widget.CardView>
            <ImageView
                android:id="@+id/imagenCorazon"
                android:layout_width="108dp"
                android:layout_height="108dp"
                android:src="@drawable/corazon_vacio"
                android:elevation="2dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:tint="@color/naranja">
            </ImageView>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="30dp"
                android:layout_margin="4dp">
                <TextView
                    android:id="@+id/botonParteCuerpo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/cuadros"
                    android:text="@string/parteDelCuerpo"
                    android:textColor="@color/textos"
                    android:textSize="15sp"
                    android:gravity="center|bottom"
                    android:paddingBottom="5dp">
                </TextView>
            </androidx.cardview.widget.CardView>
            <ImageView
                android:layout_width="115dp"
                android:layout_height="115dp"
                android:src="@drawable/parte_cuerpo"
                android:elevation="2dp"
                android:clickable="false"
                android:paddingBottom="9dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:tint="@color/naranja">
            </ImageView>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="30dp"
                android:layout_margin="4dp">
                <TextView
                    android:id="@+id/botonTipoEjercicio"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/cuadros"
                    android:text="@string/tipo_ejercicio"
                    android:textColor="@color/textos"
                    android:textSize="15sp"
                    android:gravity="center|bottom"
                    android:paddingBottom="5dp">
                </TextView>
            </androidx.cardview.widget.CardView>
            <ImageView
                android:layout_width="115dp"
                android:layout_height="110dp"
                android:src="@drawable/tipo_ejercicio"
                android:elevation="2dp"
                android:paddingBottom="9dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:tint="@color/naranja">
            </ImageView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_ejerciciosCR"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        </androidx.recyclerview.widget.RecyclerView>
    </LinearLayout>
    <Button
        android:id="@+id/boton_crearRutina"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/crearRutina"
        android:textColor="@color/textos"
        android:backgroundTint="@color/naranja"
        android:textSize="30sp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp">

    </Button>
</LinearLayout>