<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".adapters.EjercicioCreadorRutinaAdapter"
    android:orientation="horizontal">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_margin="7dp"
        app:cardCornerRadius="20dp"
        android:backgroundTint="@color/cuadros">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:weightSum="30"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="23"
                android:weightSum="20"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/nombreEjercicio"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="9"
                    android:textColor="@color/textos"
                    android:paddingStart="5dp"
                    android:text="@string/mensaje"
                    android:textSize="20sp">
                </TextView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="11"
                    android:weightSum="9">
                    <ImageView
                        android:id="@+id/corazon"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="3"
                        android:src="@drawable/corazon"
                        app:tint="@color/naranja"
                        android:layout_margin="6dp">
                    </ImageView>
                    <ImageView
                        android:id="@+id/parteCuerpo"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="3"
                        android:src="@drawable/brazos"
                        app:tint="@color/naranja"
                        android:layout_margin="6dp">
                    </ImageView>
                    <ImageView
                        android:id="@+id/tipoEjercicio"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="3"
                        android:src="@drawable/maquina"
                        app:tint="@color/naranja"
                        android:layout_margin="6dp">
                    </ImageView>
                </LinearLayout>
            </LinearLayout>
            <ImageView
                android:id="@+id/seleccionarEjercicio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="7"
                android:src="@drawable/circulo_vacio"
                app:tint="@color/naranja"
                android:layout_margin="35dp">

            </ImageView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>