<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="250dp"
    android:layout_height="325dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:weightSum="5"
    android:orientation="vertical"
    android:background="@color/textos">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:id="@+id/botonAgregarSeriePP"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/cuadros"
            android:text="@string/AgregarSerie"
            android:layout_margin="0.5dp"
            android:textColor="@color/textos"
            android:textSize="25sp"
            android:gravity="center"
            android:paddingStart="2dp"
            >
        </TextView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:id="@+id/botonQuitarSeriePP"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/cuadros"
            android:text="@string/QuitarSerie"
            android:layout_margin="0.5dp"
            android:textColor="@color/textos"
            android:textSize="25sp"
            android:gravity="center"
            android:paddingStart="2dp"
            >
        </TextView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:id="@+id/botonEliminarEjercicioPP"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/cuadros"
            android:text="@string/eliminarEjercicio"
            android:layout_margin="0.5dp"
            android:textColor="@color/textos"
            android:textSize="22sp"
            android:gravity="center"
            android:paddingStart="2dp"
            >
        </TextView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:id="@+id/botonAgregarEjercicioPP"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/cuadros"
            android:text="@string/AgregarEjercicio"
            android:layout_margin="0.5dp"
            android:textColor="@color/textos"
            android:textSize="22sp"
            android:gravity="center"
            android:paddingStart="2dp"
            >
        </TextView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:id="@+id/botonAgregarNotasPP"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/cuadros"
            android:text="@string/AgregarNotas"
            android:layout_margin="0.5dp"
            android:textColor="@color/textos"
            android:textSize="25sp"
            android:gravity="center"
            android:paddingStart="2dp"
            >
        </TextView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>